# Copy to .env, or run "npm run setup" to fill this in step by step.

# Send email from a Gmail account (needs an app password: https://myaccount.google.com/apppasswords)
SAATHI_GMAIL_USER=
SAATHI_GMAIL_APP_PASSWORD=

# Or any SMTP provider
# SAATHI_SMTP_URL=smtps://user:password@smtp.example.com:465
# SAATHI_MAIL_FROM=care@yourdomain.com

# Sign in with Google, and "Send from my Gmail" (https://console.cloud.google.com/apis/credentials)
SAATHI_GOOGLE_CLIENT_ID=
SAATHI_GOOGLE_CLIENT_SECRET=

# The address people use to reach Saathi, if not this computer (tunnel or domain)
# SAATHI_PUBLIC_URL=https://saathi.example.com

# ===== For developers =====

# --- Gemini (with neither, an offline planner is used) ---
# GEMINI_API_KEY=...                  # free key: https://aistudio.google.com/apikey
# SAATHI_GEMINI_MODEL=gemini-2.5-flash
# SAATHI_VERTEX=true                  # or use Gemini on Vertex AI with the project's service account
# SAATHI_VERTEX_LOCATION=global

# --- MCP authorization (SAATHI_AUTH_MODE = none | static) ---
# SAATHI_MCP_TOKEN=change-me         # static: elder device token (all scopes)
# SAATHI_FAMILY_TOKEN=change-me-too  # static: family device token (saathi/family only)

# --- Ring doorbell webhook ---
# SAATHI_RING_WEBHOOK_SECRET=change-me

# --- Google Cloud: switch everything on at once (npm run deploy sets these on Cloud Run) ---
# SAATHI_USE_GOOGLE=true
# GOOGLE_CLOUD_PROJECT=your-project
# SAATHI_MEDIA_BUCKET=your-project-saathi-media
# SAATHI_PUBSUB_TOPIC=saathi-events
# SAATHI_FIRESTORE_DATABASE=(default)

# --- ...or one at a time ---
# SAATHI_FIRESTORE=true
# SAATHI_GOOGLE_TRANSLATE=true
# SAATHI_GOOGLE_LANGUAGE=true
# SAATHI_GOOGLE_TTS=true
# SAATHI_PUBSUB=true
# SAATHI_CLOUD_STORAGE=true

# --- Gemini Live (voice) and Gemini images (Didi cards) use GEMINI_API_KEY ---
# SAATHI_LIVE=off                     # turn Gemini Live off
# SAATHI_LIVE_MODEL=gemini-live-2.5-flash-preview
# SAATHI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Speech-to-Text for Didi voice notes, Firebase Cloud Messaging for notifications ---
# SAATHI_GOOGLE_SPEECH=true
# SAATHI_FCM=true
# SAATHI_FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# SAATHI_FCM_VAPID_KEY=...            # Firebase console > Project settings > Cloud Messaging > Web Push certificates

# --- Help escalations on Cloud Workflows (npm run deploy sets these) ---
# SAATHI_WORKFLOWS=true
# SAATHI_WORKFLOWS_LOCATION=asia-south1
# SAATHI_RUNNER_SERVICE_ACCOUNT=saathi-runner@your-project.iam.gserviceaccount.com

# --- Firebase Authentication for email and password accounts, and phone sign-in for Didis (Project settings > Web API key) ---
# SAATHI_FIREBASE_API_KEY=...

# --- Google Maps: match Saathi Didis by travel time (Routes API) ---
# SAATHI_MAPS_API_KEY=...

# --- Exposing the local server through a tunnel (cloudflared, Tailscale) ---
# HOST=0.0.0.0
# SAATHI_ALLOWED_HOSTS=your-subdomain.example.com

# --- Hosted plans (off unless all of these are set; self-hosted Saathi never needs them) ---
# SAATHI_BILLING=razorpay
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...         # webhook URL: https://<your site>/billing/razorpay/webhook
# SAATHI_RAZORPAY_PLAN_FAMILY=plan_...
# SAATHI_RAZORPAY_PLAN_FAMILY_PLUS=plan_...
# SAATHI_RAZORPAY_PLAN_AGENCY=plan_...
# SAATHI_RAZORPAY_PLAN_CLINIC=plan_...

# --- Saathi Calls (off unless all of these are set; calls cost money per minute) ---
# SAATHI_CALLS=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...                   # a Twilio number that can call the elder's country
# TWILIO_WHATSAPP_FROM=+1...          # optional: WhatsApp sender for call summaries
# SAATHI_PUBLIC_URL must be set so Twilio can reach /calls/...

# --- Saathi Didis ---
# SAATHI_DIDI_PARTNER_CODES=SEWA-PUNE,ANNAPURNA-SHG   # codes you give partner SHGs/NGOs; a Didi who enters one is verified
